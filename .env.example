# PostgreSQL connection string (DigitalOcean managed or standalone)
# e.g., postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/west_industries"

# Auth.js secret (Generate with `openssl rand -base64 32`)
AUTH_SECRET="generate-a-random-32-byte-base64-string"

# Application URL (The URL where the app is hosted)
AUTH_URL="http://localhost:3000"

# Initial super_user credentials for the seed script
SEED_ADMIN_EMAIL="admin@westindustries.com"
SEED_ADMIN_PASSWORD="SecurePassword123!"

# Node environment
NODE_ENV="development" # Set to 'production' on the droplet

# ─── Notion sync ─────────────────────────────────────────────────────────────
# Internal integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN="ntn_xxx"
# 32-hex chunk before ?v= in the Notion database URL
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Kill switch — set to "false" to disable all push/pull. Defaults to true.
NOTION_SYNC_ENABLED="true"
# Cron schedule for the PM2 sync worker. Default is every 5 minutes.
NOTION_POLL_CRON="*/5 * * * *"
