# PostgreSQL connection string (DigitalOcean managed or standalone)
# e.g., postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/west_industries"

# Auth.js secret (Generate with `openssl rand -base64 32`)
AUTH_SECRET="generate-a-random-32-byte-base64-string"

# Application URL (The URL where the app is hosted)
AUTH_URL="http://localhost:3000"

# Set to "true" so Auth.js trusts the host when running behind a proxy or on a
# bare IP/host without HTTPS (required in production on the droplet).
AUTH_TRUST_HOST="true"

# Initial super_user credentials for the seed script
SEED_ADMIN_EMAIL="admin@westindustries.com"
SEED_ADMIN_PASSWORD="SecurePassword123!"

# Node environment
NODE_ENV="development" # Set to 'production' on the droplet

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Transactional email over HTTPS — avoids SMTP egress blocks (e.g. DigitalOcean
# blocks outbound SMTP ports). Get a key at https://resend.com/api-keys
# If unset, invite emails are skipped (the accept link is still created + logged).
RESEND_API_KEY="re_xxx"
# Sender address. Without a verified domain, use Resend's shared sender
# "onboarding@resend.dev" (can only deliver to your own account email).
# With a verified domain: e.g. "West Industries <no-reply@yourdomain.com>"
EMAIL_FROM="West Industries <onboarding@resend.dev>"
